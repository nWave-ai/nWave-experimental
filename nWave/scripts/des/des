#!/usr/bin/env python3
"""DES CLI shim — generated by nWave installer. Do not edit."""

import os
import sys
from pathlib import Path


def _resolve_runtime():
    """Pick the runtime python dir this shim imports des from.

    This shim runs before sys.path exists, so the resolution rule is
    inlined (kept byte-identical between the des and des-commit shims)
    instead of imported. Order, first hit wins:

    1. $NWAVE_RUNTIME — explicit operator override. Honored even when
       broken: an explicit override must fail loud, never be silently
       skipped for a guess.
    2. $NWAVE_AGENTS_HOME/.nwave/active-runtime (else ~/.nwave) — pointer the installer rewrites on every
       install (scripts/shared/install_paths.py record_active_runtime);
       the most recent install wins, so a Codex/Copilot/OpenCode-only
       install can never leave this launcher bound to a stale
       Claude-scoped runtime. Ignored if its recorded dir no longer
       contains a des package (e.g. after an uninstall).
    3. CLAUDE_CONFIG_DIR (else ~/.claude)/lib/python — the legacy
       Claude-scoped location (mirrors PathUtils' two-branch SSOT).
    4. $NWAVE_AGENTS_HOME/.nwave/runtime (else ~/.nwave/runtime) — the host-neutral location non-Claude hosts
       install to.

    On a dual-host box the choice is deterministic and declared:
    `des --help` prints the resolved dir and which rule chose it.
    """
    explicit = os.environ.get("NWAVE_RUNTIME", "")
    if explicit:
        return Path(explicit), "NWAVE_RUNTIME env"
    agents_home = os.environ.get("NWAVE_AGENTS_HOME", "")
    install_root = Path(agents_home) if agents_home else Path.home()
    pointer = install_root / ".nwave" / "active-runtime"
    try:
        recorded = Path(pointer.read_text().strip())
        if (recorded / "des").is_dir():
            return recorded, "active-runtime pointer"
    except (OSError, ValueError):
        pass
    config_dir = os.environ.get("CLAUDE_CONFIG_DIR", "")
    claude_dir = Path(config_dir) if config_dir else Path.home() / ".claude"
    claude_runtime = claude_dir / "lib" / "python"
    if (claude_runtime / "des").is_dir():
        return claude_runtime, "claude default"
    neutral = install_root / ".nwave" / "runtime"
    if (neutral / "des").is_dir():
        return neutral, "host-neutral fallback"
    return claude_runtime, "claude default (no runtime found)"


_RUNTIME_DIR, _RUNTIME_SOURCE = _resolve_runtime()
sys.path.insert(0, str(_RUNTIME_DIR))

if sys.argv[1:2] in (["-h"], ["--help"]):
    sys.stderr.write(
        f"nwave runtime: {_RUNTIME_DIR} (source: {_RUNTIME_SOURCE})\n"
    )

try:
    from des.cli.__main__ import main
except ImportError as exc:
    _missing = getattr(exc, "name", None) or "des"
    sys.stderr.write(
        "error: the installed nWave runtime is broken or incomplete -- "
        f"cannot import '{_missing}' from {_RUNTIME_DIR} "
        f"(resolved via {_RUNTIME_SOURCE}) ({exc}).\n"
        "why: the nWave installation is corrupted or partial (for example "
        "an interrupted, failed, or outdated install), or the resolved "
        "runtime does not match the install you expect.\n"
        "fix: reinstall the runtime with `python -m nwave_ai.cli install` "
        "or `pipx install nwave-ai`; point NWAVE_RUNTIME at the runtime "
        "dir to use explicitly; or run des from a nWave source "
        "checkout instead of this installed shim.\n"
    )
    sys.exit(1)

sys.exit(main())
