#!/usr/bin/env python3
"""DES CLI shim — generated by nWave installer. Do not edit."""

import os
import sys
from pathlib import Path


# Mirrors PathUtils' SSOT for resolving the Claude config dir: a non-empty
# CLAUDE_CONFIG_DIR wins, else Path.home() / ".claude". This shim cannot
# import that SSOT (it runs before sys.path is set up), so the same
# two-branch rule is inlined here.
_config_dir = os.environ.get("CLAUDE_CONFIG_DIR", "")
_CLAUDE_DIR = Path(_config_dir) if _config_dir else Path.home() / ".claude"

sys.path.insert(0, str(_CLAUDE_DIR / "lib" / "python"))

try:
    from des.cli.__main__ import main
except ImportError as exc:
    _missing = getattr(exc, "name", None) or "des"
    _RUNTIME_DIR = _CLAUDE_DIR / "lib" / "python"
    sys.stderr.write(
        "error: the installed nWave runtime is broken or incomplete -- "
        f"cannot import '{_missing}' from {_RUNTIME_DIR} ({exc}).\n"
        "why: the nWave installation is corrupted or partial (for example "
        "an interrupted, failed, or outdated install).\n"
        "fix: reinstall the runtime with `python -m nwave_ai.cli install` "
        "or `pipx install nwave-ai`; or run des from a nWave source "
        "checkout instead of this installed shim.\n"
    )
    sys.exit(1)

sys.exit(main())
