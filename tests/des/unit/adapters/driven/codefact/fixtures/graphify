#!/usr/bin/env python3
"""POSIX entry point for this directory's deterministic ``graphify`` stand-in.

Kept as a real, extensionless, ``chmod +x``'d executable so ``shutil.which``
+ ``subprocess`` (both unmodified, real production calls -- see
``graphify_code_fact_adapter.py``) resolve and launch it exactly like the
real ``graphify`` binary would on POSIX: the kernel's ``execve`` reads the
``#!/usr/bin/env python3`` shebang line directly, no shell involved. Windows
has no such kernel-level shebang mechanism and ``shutil.which`` there only
matches ``PATHEXT`` extensions, so the test fixture instead prepends ``.PY``
to ``PATHEXT`` there, letting ``shutil.which("graphify")`` resolve the
sibling ``graphify.py`` module directly -- both entry points delegate to the
SAME ``main`` function (defined in ``graphify.py``) so the actual behaviour
lives in exactly one place, and no shell/batch shim is needed on either
platform (CLAUDE.md's Portability rule forbids one outright).
"""

from __future__ import annotations

import sys
from pathlib import Path


sys.path.insert(0, str(Path(__file__).resolve().parent))

from graphify import main


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
